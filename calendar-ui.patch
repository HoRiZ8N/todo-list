@@ -181,3 +181,110 @@ td button {
 
 td button.unban { background: #0f6e56; }
 td button.ban { background: #b3261e; }
+
+main { max-width: 640px; }
+
+.calendar {
+  border: 1px solid #eee;
+  border-radius: 10px;
+  padding: 12px;
+  margin-bottom: 16px;
+}
+
+.calendar-nav {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  margin-bottom: 10px;
+}
+
+.month-label {
+  flex: 1;
+  text-align: center;
+  font-weight: 600;
+}
+
